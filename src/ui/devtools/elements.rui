Dock {
    side: debug.options["dock elements.rui"] || "left"; width: 380; height: 320; padding: 0; spacing: 0
    title: "Elements"; icon: "square.stack.3d.down.right"
    visible: debug.here.pane || (debug.enabled && !debug.options["hidden elements.rui"] && !(debug.panedFiles || []).includes("elements.rui"))
    ElementsPanel { grow: 1 }
}
