use "components"

Stack {
    id: wg
    property bool light: false
    property string accentName: conf.values["endfield-accent"] || "valley"
    property var pal: "0f0f10 17181a 1e2024 26282d 0a0a0b 33363c 4a4e56 f0f0f2 a8abb2 7f828a 44474d ebebeb 141519".split(" ").map((c) => "#" + c)
    property var surface: pal[0]
    property var container: pal[1]
    property var containerHigh: pal[2]
    property var containerHighest: pal[3]
    property var well: pal[4]
    property var hairline: pal[5]
    property var lineHot: pal[6]
    property var ink: pal[7]
    property var inkDim: pal[8]
    property var caption: pal[9]
    property var faint: pal[10]
    property var paper: pal[11]
    property var onPaper: pal[12]
    property var charcoal: "#383838"
    property var signal: accentName === "wuling" ? "#06a2a2" : accentName === "grey" ? (light ? "#141519" : "#d9d9d9") : "#fffa00"
    property var onSignal: accentName === "grey" && light ? "#f6f6f3" : accentName === "wuling" ? "#ffffff" : "#0f0f10"
    property var primary: !light ? (accentName === "wuling" ? "#14d0d0" : signal) : accentName === "wuling" ? "#046b6b" : accentName === "grey" ? "#34363d" : "#6b5d00"
    property var orange: light ? "#c85a00" : "#ff7a1a"
    property var green: light ? "#2e7d32" : "#7be04b"
    property var blue: light ? "#1565c0" : "#4fa8ff"
    property var red: light ? "#b3142b" : "#d91e36"
    property var magenta: "#ff1aac"
    property var mint: "#00ffa2"
    property var teal: "#06a2a2"
    property var lime: light ? "#6e8a00" : "#bce41d"
    property var valley: "#fffa00"
    property string cut: "square, cut 10, square, cut 10"
    property string cutLarge: "square, cut 16, square, cut 16"
    property string cutButton: "square, cut 7, square, cut 7"
    property string cutPlate: "square, cut 6, square, cut 6"
    property string fontUi: "HarmonyOS Sans"
    property string fontWide: "Saira"
    property string fontNum: "Space Grotesk"
    property string fontMono: "Iosevka"
    property string logoOpt: conf.values["endfield-logo"] || "game"
    property string brandDir: "~/.config/rex/distros/endfield/assets/brand/"
    property string logo: logoOpt === "emblem" ? "" : logoOpt === "game" ? brandDir + "tri-" + (light ? "ink" : accentName === "valley" ? "signal" : "white") + ".png" : logoOpt
    property string wordmark: logoOpt === "game" ? brandDir + "wordmark-" + (light ? "ink" : "white") + ".png" : ""
    property bool motion: conf.values["endfield-motion"] !== "false"
    function caps(s) { return String(s).toUpperCase(); }
    function two(n) { return (n < 10 ? "0" : "") + n; }
    property string title: ""
    property string icon: ""
    property string keys: ""
    property string dir: "tl"
    property var pick: null
    property bool on: true
    property int order: 0
    property bool hot: on && hit.hovered
    property real w: 188
    property real h: 163
    property real rest: on ? 0.84 : 0.46
    property real sw: w * rest
    property real sh: h * rest
    property real push: hot ? 18 : 0
    property real px: dir === "b" ? 0 : push * 0.5
    property real py: dir === "b" ? push : push * 0.866
    property int glide: motion ? (hot ? 220 : 340) : 0
    property var middle: dir === "tl" ? [1, 0.67] : dir === "tr" ? [0, 0.67] : [0.5, -0.33]
    property bool revealing: false
    onOnChanged: if (on) revealing = true
    Timer { interval: 520; repeat: false; running: wg.revealing; onTriggered: wg.revealing = false }
    property string tri: "svg M0 0 H1 L0.5 1 Z"
    width: w; height: h
    Button { id: hit; shape: wg.tri; stateLayer: false; onClicked: if (wg.on && wg.pick) wg.pick() }
    Column {
        halign: wg.dir === "tl" ? "right" : wg.dir === "tr" ? "left" : "center"
        valign: wg.dir === "b" ? "top" : "bottom"
        Item { visible: wg.dir === "b"; height: wg.py; animate: wg.glide; easing: "expo" }
        Row {
            animate: wg.glide; easing: "expo"
            Item { visible: wg.dir === "tr"; width: wg.px; animate: wg.glide; easing: "expo" }
            Rectangle {
                width: wg.sw; height: wg.sh; animate: wg.glide; easing: "expo"
                shape: wg.tri
                color: "transparent"
                border.width: 1; border.color: wg.hot ? signal : alpha(ink, 0.3); border.start: 0; border.end: wg.on ? 1 : 0
                Shader { source: "shaders/wedge.metal"; fps: 120; running: motion && (wg.hot || wg.revealing)
                    animate: wg.glide; easing: "expo"
                    params: [wg.hot ? 1 : 0, wg.on ? 1 : 0, wg.middle[0], wg.middle[1], motion ? 12 : 0]
                    paramsAnimation: motion ? 450 : 0
                    colors: [alpha(surface, 0.94), signal, lineHot, alpha(onSignal, 0.10)] }
                Column {
                    spacing: 0
                    opacity: wg.on ? 1 : 0; opacityAnimation: motion ? (wg.on ? 260 : 140) : 0
                    Item { height: Math.max(4, Math.round(wg.sh / 3 - (wg.keys && wg.hot ? 29 : 16))); animate: motion ? 220 : 0; easing: "expo" }
                    Row { halign: "center"
                        Icon { name: wg.icon; font.size: 14; color: wg.hot ? onSignal : primary } }
                    Item { height: 5 }
                    Row { halign: "center"
                        Text { text: caps(wg.title); align: "center"; font.family: fontWide; font.width: "expanded"; font.weight: "bold"; font.size: 9.5; font.letterSpacing: 1.1
                            color: wg.hot ? onSignal : ink; colorAnimation: 200; scramble: motion && wg.on ? 420 : 0 } }
                    Item { height: 6; visible: !!wg.keys && wg.hot }
                    Row { visible: !!wg.keys && wg.hot; halign: "center"
                        Keys { key: wg.keys; small: true; inverse: true } }
                }
            }
            Item { visible: wg.dir === "tl"; width: wg.px; animate: wg.glide; easing: "expo" }
        }
        Item { visible: wg.dir !== "b"; height: wg.py; animate: wg.glide; easing: "expo" }
    }
}
