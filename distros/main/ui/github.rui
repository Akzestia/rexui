Dock {
    side: "right"; width: 560
    group: "side"; title: "GitHub"; iconColor: "#24292f"
    icon: web.favicon || "chevron.left.forwardslash.chevron.right"
    key: "cmd+shift+g"

    property string user: String(conf.values["github-user"] || "").trim().replace(/^@/, "")

    Rectangle {
        grow: 1; radius: 10
        WebView {
            id: web
            cookies: "zen"
            url: "https://github.com/" + encodeURIComponent(user)
        }
    }
}
