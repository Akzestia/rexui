Stack {
    id: pot
    property string accentName: conf.values["endfield-accent"] || "valley"
    property var signal: accentName === "wuling" ? "#06a2a2" : accentName === "grey" ? "#d9d9d9" : "#fffa00"
    property var primary: accentName === "wuling" ? "#14d0d0" : signal
    property bool motion: conf.values["endfield-motion"] !== "false"
    function two(n) { return (n < 10 ? "0" : "") + n; }
    property int value: 0
    property real size: 40
    property var tint: ""
    property var line: "#7f828a"
    property real lineWidth: 1.2
    function pieces(from, to) {
        const ax = 1.35, cx = ax / 2, cy = 0.5, h = Math.hypot(ax / 2, 0.5), L = h * 0.98;
        const all = [];
        [[-1, -1], [1, -1], [1, 1], [-1, 1]].forEach((s, k) => {
            const d = [s[0] * (ax / 2) / h, s[1] * 0.5 / h], p = [-d[1], d[0]];
            const r0 = 0.13, w0 = 0.2, w1 = 0.06, sk = 0.05 * (k % 2 ? 1 : -1);
            all.push([[cx + d[0] * r0 + p[0] * w0 / 2, cy + d[1] * r0 + p[1] * w0 / 2], [cx + d[0] * (L + sk) + p[0] * w1 / 2, cy + d[1] * (L + sk) + p[1] * w1 / 2],
                      [cx + d[0] * (L - sk) - p[0] * w1 / 2, cy + d[1] * (L - sk) - p[1] * w1 / 2], [cx + d[0] * r0 - p[0] * w0 / 2, cy + d[1] * r0 - p[1] * w0 / 2]]);
        });
        const c = 0.085;
        all.push([[cx, cy - c], [cx + c * 1.1, cy], [cx, cy + c], [cx - c * 1.1, cy]]);
        let d = "";
        for (let i = from; i < to; i++) d += all[i].map((q, j) => (j ? " L" : "M") + (q[0] / ax).toFixed(4) + " " + q[1].toFixed(4)).join("") + " Z ";
        return d;
    }
    width: pot.size * 1.35; height: pot.size
    Path { d: pot.pieces(0, 5); stroke: pot.line; strokeWidth: pot.lineWidth; join: "miter" }
    Path { d: pot.pieces(0, Math.max(0, Math.min(5, pot.value))); fill: pot.tint || signal; stroke: pot.tint || signal; strokeWidth: pot.lineWidth; join: "miter" }
}
