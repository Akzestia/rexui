                                Stack {
                                    width: colW.ms; height: 18
                                    Row {
                                        Rectangle { width: Math.max(1, (colW.ms - 10) * modelData.ms / msTop); height: 14; radius: 3; color: modelData.ms >= 16 ? errTint : modelData.ms >= 4 ? warnTint : selColor; animate: 300; easing: "standard"; colorAnimation: 300 }
                                    }
                                    Row { horizontalPadding: 5; Text { font.family: monoFont; text: ms(modelData.ms); font.mono: true; font.size: 11; font.tabular: true; color: modelData.ms >= 16 ? errColor : modelData.ms >= 4 ? warnColor : ink } }
                                }
                                Item { width: 7; height: 1 }
                                Text { font.family: monoFont; width: colW.calls; text: String(modelData.calls); font.mono: true; font.size: 11; font.tabular: true; color: modelData.calls ? ink : faint }
                                Item { width: 7; height: 1 }
                                Text { font.family: monoFont; width: colW.evals; text: String(modelData.evals); font.mono: true; font.size: 11; font.tabular: true; color: modelData.evals ? ink : faint }
                                Item { width: 7; height: 1 }
                                Text { font.family: monoFont; width: colW.nodes; text: modelData.nodes + (modelData.natives ? " · " + modelData.natives + " native" : ""); font.mono: true; font.size: 11; font.tabular: true; color: dim; maxLines: 1 }
                                Item { width: 7; height: 1 }
                                Text { font.family: monoFont; width: colW.bcpu; wrap: true; maxLines: 3; font.mono: true; font.size: 10.5; font.tabular: true; color: modelData.backends.length ? dim : faint
                                    text: modelData.backends.length ? modelData.backends.map((b) => b.name + "  " + pct(b.cpu) + " · " + mb(b.mem)).join("\n") : "—" }
                            }
                        }
                        Button { focusable: false; id: rowP; stateLayer: false; onClicked: { const d = debug.docs.find((x) => x.path === modelData.path); if (d && d.root) debug.select(d.path, d.root); } }
                    }
                }
            }
            Column {
                visible: perfView === 1; grow: 1; spacing: 0
                Rectangle {
                    color: raised; horizontalPadding: 10; height: 24
                    Row {
                        spacing: 0
                        Text { font.family: uiFont; grow: 1; text: "Process"; font.size: 10.5; color: faint }
                        Text { font.family: uiFont; width: 64; text: "pid"; font.size: 10.5; color: faint }
                        Text { font.family: uiFont; width: 100; text: "version"; font.size: 10.5; color: faint }
                        Text { font.family: uiFont; width: 76; text: "up"; font.size: 10.5; color: faint }
                        Text { font.family: uiFont; width: 64; text: "CPU"; font.size: 10.5; color: faint }
                        Text { font.family: uiFont; width: 80; text: "CPU time"; font.size: 10.5; color: faint }
                        Text { font.family: uiFont; width: 84; text: "memory"; font.size: 10.5; color: faint }
                        Text { font.family: uiFont; width: 84; text: "threads"; font.size: 10.5; color: faint }
                        Text { font.family: uiFont; width: 70; text: "children"; font.size: 10.5; color: faint }
                        Text { font.family: uiFont; width: 60; text: "sockets"; font.size: 10.5; color: faint }
                    }
                }
                Rectangle { height: 1; color: line }
                List {
                    grow: 1; spacing: 0; verticalPadding: 2; gutter: 8
                    model: perfOn && perfView === 1 ? processes : []
                    delegate: Rectangle {
                        horizontalPadding: 10; verticalPadding: 5
                        Column {
                            spacing: 2
                            Row {
                                spacing: 0
                                Row {
                                    grow: 1; spacing: 6
                                    Text { font.family: uiFont; text: modelData.name; font.size: 12; font.weight: "semibold"; color: ink; maxLines: 1 }
                                    Rectangle {
                                        radius: 8; horizontalPadding: 6; verticalPadding: 1; color: modelData.role === "server" ? selColor : field; border.width: 1; border.color: line
                                        Text { font.family: uiFont; text: modelData.role; font.size: 10; color: modelData.role === "server" ? ink : dim }
                                    }
                                    Text { font.family: uiFont; visible: !!modelData.ours; text: "started by Rex UI"; font.size: 10; color: faint }
                                    Text { font.family: uiFont; visible: !!modelData.replaced; text: "its app changed on disk since it started (an update it hasn't restarted into)"; font.size: 10; color: warnColor; maxLines: 1 }
                                }
                                Text { font.family: monoFont; width: 64; text: String(modelData.pid); font.mono: true; font.size: 11; font.tabular: true; color: dim }
                                Text { font.family: monoFont; width: 100; text: modelData.version || "—"; font.mono: true; font.size: 11; color: dim; maxLines: 1 }
                                Text { font.family: monoFont; width: 76; text: up(modelData.started); font.mono: true; font.size: 11; font.tabular: true; color: dim }
                                Text { font.family: monoFont; width: 64; text: pct(modelData.cpu); font.mono: true; font.size: 11; font.tabular: true; color: modelData.cpu >= 100 ? errColor : modelData.cpu >= 50 ? warnColor : ink }
                                Text { font.family: monoFont; width: 80; text: secs(modelData.cpuTime); font.mono: true; font.size: 11; font.tabular: true; color: dim }
                                Text { font.family: monoFont; width: 84; text: mb(modelData.mem); font.mono: true; font.size: 11; font.tabular: true; color: ink }
                                Text { font.family: monoFont; width: 84; text: (modelData.running || 0) + " / " + (modelData.threads || 0); font.mono: true; font.size: 11; font.tabular: true; color: dim }
                                Text { font.family: monoFont; width: 70; text: String(modelData.children || 0); font.mono: true; font.size: 11; font.tabular: true; color: dim }
                                Text { font.family: monoFont; width: 60; text: String(modelData.sockets || 0); font.mono: true; font.size: 11; font.tabular: true; color: dim }
                            }
                            Text { font.family: monoFont; text: modelData.command || modelData.path || ""; font.mono: true; font.size: 10; color: faint; wrap: true; maxLines: 2 }
                        }
                    }
                }
            }
            Column {
                visible: perfView === 2; grow: 1; spacing: 0
                Rectangle {
                    color: raised; horizontalPadding: 10; height: 24
                    Row {
                        spacing: 0
                        Text { font.family: uiFont; grow: 1; text: "Thread"; font.size: 10.5; color: faint }
                        Text { font.family: uiFont; width: 70; text: "threads"; font.size: 10.5; color: faint }
                        Text { font.family: uiFont; width: 70; text: "running"; font.size: 10.5; color: faint }
                        Text { font.family: uiFont; width: 70; text: "CPU"; font.size: 10.5; color: faint }
                        Text { font.family: uiFont; width: 84; text: "CPU time"; font.size: 10.5; color: faint }
                    }
                }
                Rectangle { height: 1; color: line }
                List {
                    grow: 1; spacing: 0; verticalPadding: 2; gutter: 8; fade: 0.04
                    model: perfOn && perfView === 2 ? threadGroups : []
                    delegate: Rectangle {
                        horizontalPadding: 10; verticalPadding: 3
                        Row {
                            spacing: 0
                            Text { font.family: monoFont; grow: 1; text: modelData.name; font.mono: true; font.size: 11; color: modelData.running ? ink : dim; maxLines: 1 }
                            Text { font.family: monoFont; width: 70; text: "× " + modelData.count; font.mono: true; font.size: 11; font.tabular: true; color: dim }
                            Text { font.family: monoFont; width: 70; text: String(modelData.running); font.mono: true; font.size: 11; font.tabular: true; color: modelData.running ? okColor : faint }
                            Text { font.family: monoFont; width: 70; text: pct(modelData.cpu); font.mono: true; font.size: 11; font.tabular: true; color: modelData.cpu >= 50 ? warnColor : modelData.cpu > 0 ? ink : faint }
                            Text { font.family: monoFont; width: 84; text: secs(modelData.total); font.mono: true; font.size: 11; font.tabular: true; color: dim }
                        }
                    }
                }
            }
            Column {
                visible: perfView === 3; grow: 1; spacing: 8; padding: 10
                Row {
                    spacing: 18
                    Text { font.family: uiFont; font.size: 11.5; color: ink; text: (turnCounts.count || 0) + " turns" }
                    Text { font.family: uiFont; font.size: 11.5; color: dim; text: (turnCounts.over4 || 0) + " over 4 ms" }
                    Text { font.family: uiFont; font.size: 11.5; color: (turnCounts.over10 || 0) ? warnColor : dim; text: (turnCounts.over10 || 0) + " over 10 ms" }
                    Text { font.family: uiFont; font.size: 11.5; color: (turnCounts.over25 || 0) ? errColor : dim; text: (turnCounts.over25 || 0) + " over 25 ms" }
                    Text { font.family: uiFont; font.size: 11.5; color: dim; text: "worst " + (turnCounts.worst_ms || 0).toFixed(1) + " ms" }
                }
                Graph { height: 48; style: "bars"; gap: 1; min: 0; max: 25; color: warnColor; values: perfOn && perfView === 3 ? recentLong.map((t) => t.ms).reverse() : [] }
                Rectangle { height: 1; color: line }
                List {
                    grow: 1; spacing: 0; fade: 0.04
                    model: perfOn && perfView === 3 ? recentLong.slice(0, 40) : []
                    delegate: Row {
                        spacing: 10; height: 20
                        Text { font.family: monoFont; font.mono: true; font.size: 10.5; width: 60; color: modelData.ms >= 25 ? errColor : modelData.ms >= 10 ? warnColor : ink; text: modelData.ms.toFixed(1) + " ms" }
                        Text { font.family: uiFont; font.size: 10.5; width: 130; maxLines: 1; color: dim; text: modelData.cat + (modelData.turn ? "" : " · " + (modelData.thread || "")) }
                        Text { font.family: uiFont; font.size: 10.5; grow: 1; maxLines: 1; color: ink; text: modelData.name + (modelData.file ? "  " + modelData.file : "") }
                    }
                }
            }
        }

        List {
            visible: tab === 2; grow: 1; spacing: 1; padding: 6; gutter: 8; fade: 0.04
            opacity: faded === 2 ? 1 : 0; opacityAnimation: 180
            model: tab === 2 ? debug.docs : []
            delegate: Stack {
                Rectangle {
                    radius: r; horizontalPadding: 10; verticalPadding: 6
                    color: fileB.hovered ? hover : "transparent"; colorAnimation: fade
                    Column {
                        spacing: 2
                        Row {
                            spacing: 8
                            Rectangle { width: 7; height: 7; radius: 3.5; valign: "center"; color: modelData.error ? errColor : modelData.devtools ? faint : blue }
                            Text { font.family: monoFont; text: modelData.file; font.mono: true; font.size: 12; color: ink; maxLines: 1 }
                            Text { font.family: uiFont; text: modelData.type + (modelData.side ? " · " + modelData.side : "") + (modelData.pane ? " · in a pane" : "") + (modelData.devtools ? " · debug UI" : ""); font.size: 11; color: faint; maxLines: 1 }
                            Item { grow: 1 }
                            Text { font.family: uiFont; text: modelData.nodes + " elements"; font.size: 11; color: faint; font.tabular: true }
                        }
                        Text { font.family: monoFont; visible: !!modelData.error; text: modelData.error; wrap: true; font.mono: true; font.size: 11; color: errColor }
                        Text { font.family: monoFont; text: modelData.path; font.mono: true; font.size: 10; color: faint; maxLines: 1 }
                    }
                }
                Button { focusable: false; id: fileB; stateLayer: false; onClicked: if (modelData.root) debug.select(modelData.path, modelData.root) }
            }
        }
    }
