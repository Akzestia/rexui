    property var palettes: withRex(caelestia)
    function withRex(table) {
        const all = Object.assign({}, table);
        for (const p of (rex.themes().palettes || [])) all[p[0]] = p[1];
        return all;
    }
    function pick(name, light) {
        const mode = light ? "/light" : "/dark";
        const [family, flavour] = String(name).split("/");
        const keys = Object.keys(palettes);
        const mine = keys.filter((k) => k.startsWith(family + "/") && (!flavour || k.split("/")[1] === flavour));
        const key = mine.find((k) => k.endsWith(mode)) || mine[0] ||
                    (light ? "caelestia/rose/light" : "caelestia/rose/dark");
        const v = palettes[key].split(" ").map((c) => "#" + c);
        return { key, surface: v[0], container: v[1], containerHigh: v[2], containerHighest: v[3], primary: v[4], onPrimary: v[5], primaryContainer: v[6], onPrimaryContainer: v[7], secondary: v[8], onSecondary: v[9], secondaryContainer: v[10], onSecondaryContainer: v[11], tertiary: v[12], success: v[13], ink: v[14], inkDim: v[15], outline: v[16], outlineVariant: v[17] };
    }
    property var pal: pick(chosen, lightMode)
    function schemes() {
        const out = [];
        for (const k of Object.keys(palettes)) {
            const s = k.split("/").slice(0, 2).join("/");
            if (!out.includes(s)) out.push(s);
        }
        return out;
    }
    function current() { return pal.key.split("/").slice(0, 2).join("/"); }
}
