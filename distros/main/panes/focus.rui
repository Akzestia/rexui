Dock {
    title: "Focus"; icon: "timer"
    padding: 28; halign: "center"; valign: "center"
    color: surface

    Process { id: prefs; command: ["rexui-prefs", "dashboard"] }
    property var colors: prefs.state.colors
    property bool light: colors ? !!colors.light : !theme.dark
    property var rose: (light ? "fff8f8 faeaed f4e4e7 efdfe2 8b4a62 ffffff ffd9e3 6f334a 74565f ffffff ffd9e3 5a3f48 7d5636 4e6355 22191c 514347 837377 d5c2c6"
                              : "191114 261d20 31282a 3c3235 ffb0ca 541d34 6f334a ffd9e3 e2bdc7 422932 5a3f48 ffd9e3 f0bc95 b5ccba efdfe2 d5c2c6 9e8c91 514347").split(" ").map((c) => "#" + c)
    property var pal: colors ? ["surface", "container", "containerHigh", "containerHighest", "primary", "onPrimary", "primaryContainer", "onPrimaryContainer", "secondary", "onSecondary", "secondaryContainer", "onSecondaryContainer", "tertiary", "success", "ink", "inkDim", "outline", "outlineVariant"].map((k) => colors[k]) : rose
    property var surface: pal[0]
    property var container: pal[1]
    property var primary: pal[4]
    property var onPrimary: pal[5]
    property var secondary: pal[8]
    property var secondaryContainer: pal[10]
    property var onSecondaryContainer: pal[11]
    property var tertiary: pal[12]
    property var success: pal[13]
    property var ink: pal[14]
    property var inkDim: pal[15]
    property var outline: pal[16]

    property string phase: "focus"
    property int done: 0
    function length(p) { return (p === "focus" ? 25 : p === "long" ? 15 : 5) * 60; }
    property int total: length(phase)
    property int left: 25 * 60
    property bool ticking: false
    property var tint: phase === "focus" ? primary : success

    function next() {
        if (phase === "focus") { done += 1; phase = done % 4 === 0 ? "long" : "break"; }
        else phase = "focus";
        left = length(phase);
    }
    Timer {
        interval: 1000; running: ticking
        onTriggered: { if (left > 1) left -= 1; else { next(); ticking = false; } }
    }
    function mmss(t) { return String(Math.floor(t / 60)).padStart(2, "0") + ":" + String(t % 60).padStart(2, "0"); }

    Rectangle {
        width: 380; radius: 40; color: container; padding: 28
        Column {
            spacing: 18; halign: "center"
            Row {
                spacing: 6; halign: "center"
                Rectangle {
                    radius: 12; horizontalPadding: 12; verticalPadding: 5; color: phase === "focus" ? secondaryContainer : "transparent"; colorAnimation: 200
                    Text { text: "Focus"; font.size: 12; font.weight: "medium"; color: phase === "focus" ? onSecondaryContainer : inkDim }
                }
                Rectangle {
                    radius: 12; horizontalPadding: 12; verticalPadding: 5; color: phase === "break" ? secondaryContainer : "transparent"; colorAnimation: 200
                    Text { text: "Break"; font.size: 12; font.weight: "medium"; color: phase === "break" ? onSecondaryContainer : inkDim }
                }
                Rectangle {
                    radius: 12; horizontalPadding: 12; verticalPadding: 5; color: phase === "long" ? secondaryContainer : "transparent"; colorAnimation: 200
                    Text { text: "Long break"; font.size: 12; font.weight: "medium"; color: phase === "long" ? onSecondaryContainer : inkDim }
                }
            }
            Stack {
                width: 260; height: 260; halign: "center"; valign: "center"
                Arc {
                    value: left / total; start: -90; sweep: 360; thickness: 12; gap: 12
                    wavy: ticking; waves: 12; waving: ticking
                    color: tint; track: secondaryContainer
                }
                Column {
                    spacing: 2; halign: "center"
                    Text { text: mmss(left); font.size: 54; font.weight: "light"; font.mono: true; color: ink }
                    Text { text: ticking ? (phase === "focus" ? "stay with it" : "breathe") : left === total ? "ready" : "paused"; font.size: 13; color: inkDim }
                }
            }
            Row {
                spacing: 6; halign: "center"
                Grid {
                    columns: 4; spacing: 6
                    model: 4
                    delegate: Rectangle { width: 10; height: 10; radius: 5; color: index < done % 4 || (done > 0 && done % 4 === 0) ? tint : secondaryContainer; colorAnimation: 200 }
                }
                Text { visible: done >= 4; text: "×" + Math.floor(done / 4); font.size: 11; color: inkDim }
            }
            Row {
                spacing: 8; halign: "center"
                Stack {
                    Rectangle {
                        width: 52; height: 52; radius: 26; color: secondaryContainer; halign: "center"; valign: "center"
                        Icon { name: "arrow.counterclockwise"; font.size: 17; color: onSecondaryContainer }
                    }
                    Button { onClicked: { ticking = false; left = total; } }
                }
                Stack {
                    Rectangle {
                        width: 108; height: 52; radius: ticking ? 16 : 26; color: tint; halign: "center"; valign: "center"; animate: 200
                        Icon { name: ticking ? "pause.fill" : "play.fill"; font.size: 20; color: onPrimary }
                    }
                    Button { onClicked: ticking = !ticking }
                }
                Stack {
                    Rectangle {
                        width: 52; height: 52; radius: 26; color: secondaryContainer; halign: "center"; valign: "center"
                        Icon { name: "forward.end.fill"; font.size: 17; color: onSecondaryContainer }
                    }
                    Button { onClicked: { next(); ticking = false; } }
                }
            }
        }
    }
}
