Dock {
    title: "Spark"; icon: "staroflife.fill"
    color: surface

    property string scheme: conf.values["clay-scheme"] || "auto"
    property bool light: scheme === "ivory" || (scheme === "auto" && !theme.dark)
    property var pal: (light ? "faf9f5 f0eee6 e8e6dc dedcd1 c6613f ffffff 141413 5e5d59 87867f"
                             : "1f1e1d 262624 30302e 3a3936 d97757 ffffff f5f4ef c2c0b6 8e8c85").split(" ").map((c) => "#" + c)
    property var surface: pal[0]
    property var ink: pal[6]
    property var inkDim: pal[7]
    property var outline: pal[8]
    property var clay: "#d97757"
    property var kraft: "#d4a27f"
    property bool motion: conf.values["clay-motion"] !== "false"

    Process { id: sys; command: "clay-sys" }
    property real busy: Math.max(0, Math.min(1, ((sys.state.cpu || 0) - 0.3) / 0.5))
    property var now: new Date()
    Timer { interval: 60000; aligned: true; onTriggered: now = new Date() }
    function two(n) { return (n < 10 ? "0" : "") + n; }

    Stack {
        grow: 1
        Shader {
            source: "../ui/shaders/contour.metal"; running: motion; fps: 30
            colors: [light ? "#2e141413" : "#26faf9f5", clay]
            params: [16, 280, 0.02, 0.8, 0]
        }
        Column {
            halign: "center"; valign: "center"; spacing: 14
            Stack { width: 200; height: 200; Shader { source: "../ui/shaders/spark.metal"; colors: [clay, kraft]; params: [12, busy, 1, 1]; running: motion } }
            Item { height: 8 }
            Text { text: two(now.getHours()) + ":" + two(now.getMinutes()); font.family: "serif"; font.weight: "light"; font.size: 56; font.tabular: true; color: ink }
            Text { text: now.toLocaleDateString(i18n.locale, { weekday: "long", day: "numeric", month: "long" }); font.family: "serif"; font.italic: true; font.size: 18; color: inkDim }
        }
    }
}
