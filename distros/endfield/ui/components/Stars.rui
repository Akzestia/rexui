Stack {
    id: st
    property string accentName: conf.values["endfield-accent"] || "valley"
    property var signal: accentName === "wuling" ? "#06a2a2" : accentName === "grey" ? "#d9d9d9" : "#fffa00"
    property var primary: accentName === "wuling" ? "#14d0d0" : signal
    property bool motion: conf.values["endfield-motion"] !== "false"
    function two(n) { return (n < 10 ? "0" : "") + n; }
    property int count: 0
    property real size: 10
    property var tint: "#fcba00"
    property real step: 1.04
    function arms(long) {
        const n = Math.max(0, st.count), wu = Math.max(1, (n - 1) * st.step + 1);
        const g = 0.03, w = 0.25, L1 = 0.40, L2 = 0.36, slant = 0.45, s60 = Math.sin(Math.PI / 3);
        let d = "";
        for (let k = 0; k < 3; k++) {
            const t1 = -Math.PI / 2 + k * 2 * Math.PI / 3, t2 = t1 + 2 * Math.PI / 3, tb = t1 + Math.PI / 3;
            const u1 = [Math.cos(t1), Math.sin(t1)], u2 = [Math.cos(t2), Math.sin(t2)], bi = [Math.cos(tb), Math.sin(tb)];
            const n1 = [-u1[1], u1[0]], n2 = [u2[1], -u2[0]];
            const at = (u, r, nn, o) => [r * u[0] + o * nn[0], r * u[1] + o * nn[1]];
            const P = [bi[0] * g / s60, bi[1] * g / s60], D = [bi[0] * (g + w) / s60, bi[1] * (g + w) / s60];
            const quad = long ? [P, at(u1, L1, n1, g), at(u1, L1 + w * slant, n1, g + w), D] : [P, D, at(u2, L2 - w * slant, n2, g + w), at(u2, L2, n2, g)];
            for (let i = 0; i < n; i++)
                d += quad.map((q, j) => (j ? " L" : "M") + ((i * st.step + 0.5 + q[0]) / wu).toFixed(4) + " " + (0.5 + q[1]).toFixed(4)).join("") + " Z ";
        }
        return d;
    }
    width: st.size * Math.max(1, (st.count - 1) * st.step + 1); height: st.size
    Path { d: st.arms(true); fill: st.tint; stroke: "transparent"; strokeWidth: 0 }
    Path { d: st.arms(false); fill: st.tint; stroke: "transparent"; strokeWidth: 0 }
    Path { d: st.arms(false); fill: "#4dffffff"; stroke: "transparent"; strokeWidth: 0 }
}
