// Copyright (c) 2026-present アクゼスティア
// SPDX-License-Identifier: MIT
use "components"

use "rexshared" as Shared
Dock {
    id: settingsTop
    Shared.SettingsCore { id: core; cmdField: cmdField; cmdk: cmdk; confSettle: confSettle; expectEnd: expectEnd; run: settingsTop.run; rx: rx; search: search; sections: settingsTop.sections }
    side: "top"; height: 0; span: "window"; resizable: false

    Process { id: rx; command: "rexui-rex"; onStateChanged: core.settle(state.defaults || {}) }

    property bool light: false
    property string accentName: conf.values["endfield-accent"] || "valley"
    property var pal: "0f0f10 17181a 1e2024 26282d 0a0a0b 33363c 4a4e56 f0f0f2 a8abb2 7f828a 44474d ebebeb 141519".split(" ").map((c) => "#" + c)
    property var surface: pal[0]
    property var container: pal[1]
    property var containerHigh: pal[2]
    property var containerHighest: pal[3]
    property var well: pal[4]
    property var hairline: pal[5]
    property var lineHot: pal[6]
    property var ink: pal[7]
    property var inkDim: pal[8]
    property var caption: pal[9]
    property var faint: pal[10]
    property var paper: pal[11]
    property var onPaper: pal[12]
    property var charcoal: "#383838"
    property var signal: accentName === "wuling" ? "#06a2a2" : accentName === "grey" ? (light ? "#141519" : "#d9d9d9") : "#fffa00"
    property var onSignal: accentName === "grey" && light ? "#f6f6f3" : accentName === "wuling" ? "#ffffff" : "#0f0f10"
    property var primary: !light ? (accentName === "wuling" ? "#14d0d0" : signal) : accentName === "wuling" ? "#046b6b" : accentName === "grey" ? "#34363d" : "#6b5d00"
    property var orange: light ? "#c85a00" : "#ff7a1a"
    property var green: light ? "#2e7d32" : "#7be04b"
    property var blue: light ? "#1565c0" : "#4fa8ff"
    property var red: light ? "#b3142b" : "#d91e36"
    property var magenta: "#ff1aac"
    property var mint: "#00ffa2"
    property var teal: "#06a2a2"
    property var lime: light ? "#6e8a00" : "#bce41d"
    property var valley: "#fffa00"
    property string cut: "square, cut 10, square, cut 10"
    property string cutLarge: "square, cut 16, square, cut 16"
    property string cutButton: "square, cut 7, square, cut 7"
    property string cutPlate: "square, cut 6, square, cut 6"
    property string fontUi: "HarmonyOS Sans"
    property string fontWide: "Saira"
    property string fontNum: "Space Grotesk"
    property string fontMono: "Iosevka"
    property string logoOpt: conf.values["endfield-logo"] || "game"
    property string brandDir: "~/.config/rex/distros/endfield/assets/brand/"
    property string logo: logoOpt === "emblem" ? "" : logoOpt === "game" ? brandDir + "tri-" + (light ? "ink" : accentName === "valley" ? "signal" : "white") + ".png" : logoOpt
    property string wordmark: logoOpt === "game" ? brandDir + "wordmark-" + (light ? "ink" : "white") + ".png" : ""
    property bool motion: conf.values["endfield-motion"] !== "false"
    function caps(s) { return String(s).toUpperCase(); }
    function two(n) { return (n < 10 ? "0" : "") + n; }
    property bool gameMarks: logoOpt === "game" && !!files.stat(brandDir + "tri.png")
    property bool gameWord: gameMarks && !!files.stat(brandDir + "wordmark.png")
    property string logoPicture: logoOpt !== "game" && logoOpt !== "emblem" ? logoOpt : ""
    property bool ownEmblem: !gameMarks && !logoPicture
    property var markInk: light ? "#141519" : accentName === "valley" ? valley : "#f0f0f2"
    property var wordInk: light ? "#141519" : "#f0f0f2"
    property var onPrimary: onSignal
    property var outlineVariant: hairline
    property var primaryContainer: alpha(signal, light ? 0.35 : 0.14)
    property var onPrimaryContainer: light ? ink : signal
    property var secondary: blue
    property var secondaryContainer: containerHigh
    property var onSecondaryContainer: ink
    property var tertiary: orange
    property var success: green
    Process {
        id: nvimOpen; restart: false; running: !!core.configPath
        command: core.nvimRemote
    }
    property var luaColors: ({ comment: caption, string: tertiary, keyword: primary, number: secondary, call: secondary })
    property var confColors: ({ comment: caption, string: tertiary, keyword: secondary, number: secondary, key: primary })

    property var sections: core.rexSections({ title: "Window", icon: "macwindow", palette: "endfield's",
                                              agentsHelp: "Installs a Rex skill and session hooks, so the agent tools Rex knows learn how to use it." }, [
                                                  { title: "endfield", icon: "diamond", rows: [
                                                      core.hd("Look"),
                                                      core.rexuiOpt(core.ch("endfield-accent", "Accent", "valley", "valley:Valley|wuling:Wuling|grey:Grey", "The signal colour: Valley's yellow, Wuling's teal, or grey.")),
                                                      core.rexuiOpt(core.sw("endfield-motion", "Motion", true, "Shaders move, elements flicker on, figures decode. Off: all of it still.")),
                                                      core.rexuiOpt(core.sw("endfield-boot", "Boot", true, "Once per load, a yellow rule wipes along the HUD.")),
                                                      core.rexuiOpt(core.ch("loading-screen", "Loading screen", "ui/loading.rui", "ui/loading.rui:endfield's|none:None", "Over the whole window at launch while the docks load behind it.")),
                                                      core.rexuiOpt(core.tx("endfield-loading", "Loading capture", "", "Your own capture of a loading screen (a movie, GIF or picture), played full window instead of endfield's: e.g. assets/brand/loading.mp4. Empty: endfield's own.", "assets/brand/loading.mp4")),
                                                      core.act("loading.preview", "Preview the loading screen", "As at launch, over the window, without loading anything.", "Preview"),
                                                      core.rexuiOpt(core.tx("endfield-callsign", "Callsign", "", "What the Terminal calls you. Empty: your login name.")),
                                                      core.rexuiOpt(core.tx("endfield-logo", "Logo", "game", "game: the game's own marks (assets/marks.sh fetches them; without them, endfield's own); emblem: endfield's own; or a picture's path.", "game")),
                                                      core.hd("Panes"),
                                                      core.rexuiOpt(core.ch("endfield-pane-background", "Background", "blueprint", "blueprint:Blueprint|survey:Survey|dots:Dots|curtain:Curtain|ribbon:Ribbon|hatch:Hatch|none:None", "Every pane's, unless a pane has its own (the context menu's Background).")),
                                                      core.rexuiOpt(core.ch("endfield-pane-frame", "Frame", "cut", "sharp:Sharp|cut:Cut|notch:Notch|round:Round", "Every pane's corners, unless a pane has its own (the context menu's Frame).")),
                                                      core.rexuiOpt(core.nm("endfield-pane-dim", "Media dim", 0.72, 0, 1, 0.05, "", "How much a picture or movie behind a pane is dimmed (0: as it is, 1: gone), unless a pane has its own (the context menu's Dim). Never the shaders.")),
                                                      core.rexuiOpt(core.nm("endfield-pane-blur", "Media blur", 0, 0, 64, 1, " pt", "How much a picture or movie behind a pane is blurred, unless a pane has its own (the context menu's Blur). Never the shaders.")),
                                                      core.rexuiOpt(core.ch("endfield-activity", "Activity", "endfield", "endfield:Squad|rex:Rex's own", "What cmd+. opens: the Squad panel, or Rex's Activity popover.")),
                                                      core.rexuiOpt(core.ch("endfield-squad-keys", "Squad keys", "dvorak", "dvorak:Dvorak|qwerty:QWERTY", "Moving through Squad's cards: Dvorak's h t n s, or QWERTY's h j k l (the arrows either way); z shows or hides Standby.")),
                                                      core.hd("Missions"),
                                                      core.rexuiOpt(core.tx("missions-folder", "Folder", "~/Documents/Missions", "Where Missions keeps missions.md (made with the first mission).")),
                                                      core.hd("Game"),
                                                      core.rexuiOpt(core.ch("endfield-game-keys", "Keys", "qwerty", "system:Auto|dvorak:Dvorak|qwerty:QWERTY", "cmd+alt+g's Endfield: Auto, the game gets the keys you type; Dvorak, for a keyboard typing Dvorak itself (its firmware, macOS on ABC): every key as typed but its ,aoe, which are WASD (the game's E, O and , are on no key); QWERTY, WASD are where WASD are with macOS on any layout. Steam starts again with a new one.")),
                                                      core.hd("Account"),
                                                      core.rexuiOpt(core.ch("skport-browser", "Login from", "zen", "zen:Zen|firefox:Firefox", "The browser you're logged in to SKPort in: the Account reads your Endfield account with that login (a copy of its cookies, only read).")),
                                                      core.rexuiOpt(core.sw("skport-demo", "Demo", true, "A made-up account instead of yours: the Account and the Terminal filled without an SKPort login. Nothing is read or sent. Off: your own account, with your browser's SKPort login.")),
                                                      core.rexuiOpt(core.nm("skport-every", "Read every", 5, 2, 60, 1, " min", "How often the Account reads SKPort again.")),
                                                  ] },
    ])

    function run(name, args) { if (name === "loading.preview") loading.preview(); else rex.run(name, args || undefined); }
    Timer { id: confSettle; interval: 3000; repeat: false; running: false; onTriggered: { running = false; core.confPending = ({}); } }
    Timer {
        id: expectEnd; interval: 2000; repeat: false; running: false
        onTriggered: { running = false; core.pending = ({}); rx.send({ refresh: "defaults" }); }
    }

    FileDialog {
        id: themeFile; title: qsTr("Import a theme file")
        onAccepted: run("client.theme.import", { path: path })
    }
    FileDialog {
        id: gifFile; title: qsTr("Choose a background GIF"); types: ["gif"]
        onAccepted: rx.send({ conf: { "background-gif": path } })
    }

    Drawer {
        id: cmdk
        placement: "top"; rounding: 0; shape: cutLarge; color: surface; animation: 240
        width: core.cmdWidth; padding: 10; spacing: 6; resizable: false
        command: core.ownPalette ? ["client.palette.toggle"] : []
        onCommanded: { core.cmdAsk = null; cmdField.text = ""; core.cmdQuery = ""; core.cmdPicked = 0; core.cmdKeys = rex.shortcuts(); core.cmdOpen = true; }
        onClosed: { core.cmdOpen = false; core.cmdAsk = null; }

        Row { spacing: 6; horizontalPadding: 2
            Rectangle { width: 24; height: 3; color: valley }; Rectangle { width: 12; height: 3; color: mint }; Rectangle { width: 12; height: 3; color: magenta }
            Item { width: 4 }
            Text { text: "// " + caps(core.cmdAsk ? qsTr("Arguments") : qsTr("Command")); font.family: fontMono; font.mono: true; font.size: 8.5; font.letterSpacing: 0.6; color: caption } }
        Rectangle {
            color: well; horizontalPadding: 12; verticalPadding: 9; shape: cutButton
            border.width: 1; border.color: core.cmdQuery || core.cmdAsk ? signal : hairline
            Row {
                spacing: 10
                Stack { width: 18; height: 18; Shader { visible: ownEmblem; source: "shaders/emblem.metal"; colors: [signal, valley]; params: [core.cmdAsk ? 1 : 0, 1, 1, 1.2]; running: ownEmblem && motion && core.cmdOpen; fps: 30 }; Shader { visible: gameMarks; source: "shaders/mark.metal"; image: gameMarks ? brandDir + "tri.png" : ""; colors: [markInk]; running: false }; Image { visible: !!logoPicture; source: logoPicture; fit: "contain" } }
                Text { text: ">>"; font.family: fontMono; font.mono: true; font.size: 11; font.weight: "bold"; color: primary }
                Text { visible: !!core.cmdAsk; text: core.cmdAsk ? core.cmdAsk.it.label.replace(/…$/, "") : ""; font.family: fontUi; font.size: 14; font.weight: "medium"; color: primary }
                TextField {
                    id: cmdField
                    grow: 1; font.family: fontUi; font.size: 14; color: ink
                    placeholder: core.cmdAsk ? core.cmdAsk.need[0] + (core.cmdAbout(core.cmdAsk) ? ": " + core.cmdAbout(core.cmdAsk) : "") : qsTr("Run a command, go to a tab, pick a theme…")
                    autofocus: true; arrows: true
                    onTextChanged: { if (core.cmdAsk) core.cmdArg = text; else { core.cmdQuery = text; core.cmdPicked = 0; } }
                    onAccepted: { if (core.cmdAsk) core.cmdGive(core.cmdArg); else core.cmdRun(core.cmdItems[core.cmdPicked]); }
                    onCancelled: { if (core.cmdAsk) { core.cmdAsk = null; cmdField.text = core.cmdQuery; } else cmdk.open = false; }
                    onArrow: { if (!core.cmdAsk) core.cmdMove(direction); }
                }
            }
        }
        List {
            visible: !core.cmdAsk && core.cmdItems.length > 0
            spacing: 1; maxHeight: 340
            reveal: core.cmdOpen ? core.cmdPicked : -1
            model: core.cmdItems
            delegate: Stack {
                property bool on: index === core.cmdPicked
                Rectangle {
                    horizontalPadding: 10; verticalPadding: 7
                    color: on ? signal : "transparent"; colorAnimation: 90
                    Row {
                        spacing: 8
                        Icon { name: modelData.icon || "command"; font.size: 12; width: 18; color: on ? onSignal : caption }
                        Text { text: modelData.label; font.family: fontUi; font.size: 13; color: on ? onSignal : ink }
                        Item { grow: 1 }
                        Text { visible: !!modelData.kind; text: "// " + qsTr(modelData.kind).toUpperCase(); font.family: fontMono; font.mono: true; font.size: 8.5; font.letterSpacing: 0.5; color: on ? alpha(onSignal, 0.7) : caption }
                        KeyCap { visible: modelData.keys.length > 0; key: modelData.keys[0] || ""; small: true; inverse: on }
                        Text { visible: modelData.keys.length > 1; text: "+" + (modelData.keys.length - 1); font.family: fontMono; font.size: 9; font.mono: true; color: on ? onSignal : caption }
                    }
                }
                Button { onClicked: core.cmdRun(modelData) }
            }
        }
        Item {
            visible: !core.cmdAsk && core.cmdItems.length === 0; horizontalPadding: 10; verticalPadding: 6
            Text { text: qsTr("Nothing matches “%1”.", core.cmdQuery); font.size: 12; color: inkDim }
        }
        Rectangle { height: 1; color: hairline }
        Row {
            horizontalPadding: 10; verticalPadding: 2; spacing: 12
            Text { text: core.cmdAsk ? (core.cmdAsk.need.length > 1 ? qsTr("↩ next") : qsTr("↩ run")) : qsTr("↑↓ choose"); font.family: fontMono; font.mono: true; font.size: 9; color: caption }
            Text { text: core.cmdAsk ? qsTr("esc back") : qsTr("↩ run"); font.family: fontMono; font.mono: true; font.size: 9; color: caption }
            Text { visible: !core.cmdAsk; text: qsTr("esc close"); font.family: fontMono; font.mono: true; font.size: 9; color: caption }
            Item { grow: 1 }
            Text { visible: !core.cmdAsk && core.cmdFound.length > 0; text: core.cmdFound.length > core.cmdItems.length ? qsTr("%1 of %2 commands", core.cmdItems.length, core.cmdFound.length) : qsTr(core.cmdFound.length === 1 ? "%1 command" : "%1 commands", core.cmdFound.length); font.family: fontMono; font.mono: true; font.size: 9; color: caption }
        }
    }

    Drawer {
        id: panel
        placement: "center"; rounding: 0; shape: cutLarge; color: surface; animation: 300
        width: 1040; height: 700
        command: ["client.settings", "client.config.open"]
        exclusive: "rex-panels"
        onCommanded: { if (name === "client.config.open") { core.clearSearch(); core.section = core.sectionOf("config"); } }
        onClosed: core.clearSearch()

        Row {
            grow: 1
            valign: "stretch"

            Rectangle {
                width: 236; color: container; padding: 16
                Column {
                    spacing: 4
                    Row {
                        spacing: 10; horizontalPadding: 4; verticalPadding: 4
                        Stack { width: 22; height: 22; Shader { visible: ownEmblem; source: "shaders/emblem.metal"; colors: [signal, valley]; params: [0, 1, 1, 1.3]; running: ownEmblem && motion && panel.open; fps: 30 }; Shader { visible: gameMarks; source: "shaders/mark.metal"; image: gameMarks ? brandDir + "tri.png" : ""; colors: [markInk]; running: false }; Image { visible: !!logoPicture; source: logoPicture; fit: "contain" } }
                        Column { spacing: 1
                            Text { text: "// " + caps(qsTr("System")); font.family: fontMono; font.mono: true; font.size: 8.5; font.letterSpacing: 0.6; color: caption }
                            Text { text: caps(qsTr("Settings")); font.family: fontWide; font.width: "expanded"; font.weight: "bold"; font.size: 15; font.letterSpacing: 0.6; color: ink } }
                    }
                    Item { height: 10 }
                    Rectangle {
                        shape: cutButton; color: well; horizontalPadding: 10; verticalPadding: 7; border.width: 1; border.color: core.query ? signal : hairline
                        Row {
                            spacing: 8
                            Text { text: ">>"; font.family: fontMono; font.mono: true; font.size: 10; font.weight: "bold"; color: core.query ? primary : caption }
                            TextField { id: search; grow: 1; placeholder: qsTr("Search"); font.family: fontUi; font.size: 13; color: ink; autofocus: true; onTextChanged: core.query = text; onCancelled: core.clearSearch() }
                        }
                    }
                    Item { height: 8 }
                    List {
                        grow: 1; spacing: 1
                        model: sections
                        delegate: Stack {
                            property bool on: !core.query && index === core.section
                            Rectangle { color: on ? signal : sectionHit.hovered ? containerHigh : "transparent"; colorAnimation: 140 }
                            Row {
                                Rectangle { width: 3; height: 30; color: on ? "transparent" : sectionHit.hovered ? signal : hairline }
                                Row {
                                    spacing: 10; horizontalPadding: 9; height: 30
                                    Text { text: two(index + 1); font.family: fontMono; font.mono: true; font.size: 9; color: on ? alpha(onSignal, 0.6) : faint }
                                    Icon { name: modelData.icon; font.size: 12; width: 16; colorAnimation: 140; color: on ? onSignal : caption }
                                    Text { text: qsTr(modelData.title); font.family: fontUi; font.size: 13; colorAnimation: 140; font.weight: on ? "bold" : "regular"; color: on ? onSignal : inkDim }
                                }
                            }
                            Button { id: sectionHit; stateLayer: false; onClicked: { core.clearSearch(); core.section = index; } }
                        }
                    }
                    Text { text: rx.state.version ? "// REX " + rx.state.version : ""; font.family: fontMono; font.mono: true; font.size: 8.5; color: faint }
                }
            }

            Column {
                grow: 1; padding: 28; spacing: 16

                Row {
                    spacing: 16; valign: "top"
                    Heading { grow: 1; index: two(core.section + 1); code: qsTr("Settings"); title: core.query ? qsTr("Search") : qsTr(core.page.title); ghost: core.query ? "" : core.page.title; size: 26 }
                    Close { onClicked: panel.open = false }
                }

                Stack {
                    grow: 1; detachHidden: true
                    visible: !!core.query || !core.page.special
                    model: core.pageList
                    delegate: Stack {
                        property bool ready: false
                        visible: modelData.search ? !!core.query : !core.query && index === core.section
                        Timer { interval: 300 + index * 120; repeat: false; onTriggered: ready = true }
                        List {
                            spacing: 8
                            model: modelData.search ? (core.query ? core.found(core.query) : []) : (ready || index === core.section ? modelData.rows : [])
                            delegate: Rectangle {
                                property var r: modelData
                                radius: 0; padding: r.k === "heading" || r.k === "note" ? 0 : 14
                                horizontalPadding: r.k === "heading" || r.k === "note" ? 4 : 16; verticalPadding: r.k === "heading" ? 6 : (r.k === "note" ? 0 : 14)
                                color: r.k === "heading" || r.k === "note" ? "transparent" : container
                                border.width: r.k === "heading" || r.k === "note" ? 0 : 1; border.color: hairline
                                Column {
                                    spacing: 10; detachHidden: true
                                    Row { visible: r.k === "heading"; spacing: 6
                                        Text { text: "◆"; font.size: 8; color: primary }
                                        Text { text: qsTr(r.label).toUpperCase(); font.family: fontWide; font.width: "expanded"; font.size: 10; font.weight: "semibold"; font.letterSpacing: 1.2; color: primary } }
                                    Text { visible: r.k === "note"; text: "※ " + qsTr(r.label); font.family: fontUi; font.size: 13; color: inkDim; wrap: true }
                                    Row {
                                        visible: r.k !== "heading" && r.k !== "note"; spacing: 12; detachHidden: true
                                        Column {
                                            grow: 1; spacing: 3
                                            Text { text: qsTr(r.label); font.family: fontUi; font.size: 14; font.weight: "medium"; color: ink }
                                            Text { visible: !!r.help; text: qsTr(r.help); font.family: fontUi; font.size: 11.5; color: inkDim; wrap: true }
                                        }
                                        Stack {
                                            visible: !!r.key && r.k !== "action" && core.isSet(r)
                                            Rectangle { width: 26; height: 26; radius: 0; color: "transparent"; halign: "center"; valign: "center"; Icon { name: "arrow.uturn.backward"; font.size: 11; color: caption } }
                                            Button { onClicked: core.setv(r, null) }
                                        }
                                        Text { visible: r.k === "number"; text: r.k === "number" ? "| " + core.shown(r) : ""; font.family: fontNum; font.size: 14; font.tabular: true; color: primary }
                                        Text { visible: r.k === "info"; text: r.k === "info" ? r.get() : ""; font.family: fontMono; font.size: 12; font.mono: true; color: inkDim }
                                        Stack {
                                            visible: r.k === "switch"; width: 88; height: 26
                                            Rectangle { radius: 0; color: well; border.width: 1; border.color: hairline }
                                            Row {
                                                padding: 3; spacing: 0
                                                Rectangle { width: 41; height: 20; radius: 0; halign: "center"; valign: "center"; color: core.val(r) ? signal : "transparent"; colorAnimation: 160
                                                    Text { text: qsTr("ON"); font.family: fontWide; font.width: "expanded"; font.weight: "bold"; font.size: 8.5; font.letterSpacing: 0.8; color: core.val(r) ? onSignal : caption; colorAnimation: 160 } }
                                                Rectangle { width: 41; height: 20; radius: 0; halign: "center"; valign: "center"; color: core.val(r) ? "transparent" : charcoal; colorAnimation: 160
                                                    Text { text: qsTr("OFF"); font.family: fontWide; font.width: "expanded"; font.weight: "bold"; font.size: 8.5; font.letterSpacing: 0.8; color: core.val(r) ? caption : "#f2f2f2"; colorAnimation: 160 } }
                                            }
                                            Button { onClicked: core.setv(r, !core.val(r)) }
                                        }
                                        Rectangle {
                                            visible: r.k === "text" || r.k === "color"; width: 280; shape: cutButton; color: well; border.width: 1; border.color: hairline
                                            horizontalPadding: 10; verticalPadding: 6
                                            Row {
                                                spacing: 8
                                                Rectangle { visible: r.k === "color"; width: 14; height: 14; radius: 0; color: r.k === "color" && core.val(r) ? core.val(r) : primary }
                                                TextField {
                                                    grow: 1; font.family: fontUi; font.size: 13; color: ink
                                                    text: r.k === "text" || r.k === "color" ? String(core.val(r) ?? "") : ""
                                                    placeholder: qsTr(r.hint) || (r.k === "color" ? "#rrggbb" : "")
                                                    onAccepted: core.setv(r, text)
                                                }
                                                Stack {
                                                    visible: r.key === "background-gif"
                                                    Icon { name: "folder"; font.size: 12; color: inkDim }
                                                    Button { onClicked: gifFile.open() }
                                                }
                                            }
                                        }
                                        Stack {
                                            visible: r.k === "action" || r.k === "import"
                                            Rectangle {
                                                shape: cutButton; color: "transparent"; border.width: 1; border.color: lineHot; horizontalPadding: 14; verticalPadding: 7
                                                Text { text: caps(qsTr(r.k === "import" ? "Import…" : (r.button || "Run"))); font.family: fontMono; font.mono: true; font.size: 11; font.weight: "bold"; font.letterSpacing: 1.1; color: ink }
                                            }
                                            Button { onClicked: { if (r.k === "import") themeFile.open(); else run(r.run, r.args); } }
                                        }
                                    }
                                    Slider {
                                        visible: r.k === "number"
                                        from: r.min || 0; to: r.max || 1; value: r.k === "number" ? core.val(r) : 0
                                        onMoved: { const v = core.snap(r, value); if (r.src !== "conf" || v !== core.val(r)) core.setv(r, v); }
                                        onReleased: core.setv(r, core.snap(r, value))
                                    }
                                    Grid {
                                        visible: r.k === "choice" || r.k === "multi"; spacing: 6
                                        columns: Math.min(6, (r.options || []).length || 1)
                                        model: (r.options || []).map((o) => ({ o: o, r: r }))
                                        delegate: Stack {
                                            Rectangle {
                                                horizontalPadding: 10; verticalPadding: 7
                                                color: core.chosen(modelData.r, modelData.o[0]) ? signal : containerHigh; colorAnimation: 140
                                                border.width: 1; border.color: core.chosen(modelData.r, modelData.o[0]) ? signal : hairline
                                                Text { text: qsTr(modelData.o[1]); align: "center"; font.family: fontUi; font.size: 12; font.weight: "medium"; colorAnimation: 140; color: core.chosen(modelData.r, modelData.o[0]) ? onSignal : ink }
                                            }
                                            Button { onClicked: core.choose(modelData.r, modelData.o[0]) }
                                        }
                                    }
                                    List {
                                        visible: r.k === "font"; height: r.k === "font" ? 200 : 0
                                        model: r.k === "font" ? core.fonts.map((f) => ({ f: f, r: r })) : []
                                        delegate: Stack {
                                            Rectangle {
                                                radius: 0; horizontalPadding: 10; verticalPadding: 5
                                                color: core.val(modelData.r) === modelData.f ? secondaryContainer : "transparent"; colorAnimation: 160
                                                Row {
                                                    Text { text: modelData.f; font.family: modelData.f; font.size: 13; color: core.val(modelData.r) === modelData.f ? onSecondaryContainer : ink }
                                                    Item { grow: 1 }
                                                    Icon { visible: core.val(modelData.r) === modelData.f; name: "checkmark"; font.size: 11; color: onSecondaryContainer }
                                                }
                                            }
                                            Button { onClicked: core.setv(modelData.r, modelData.f) }
                                        }
                                    }
                                    Grid {
                                        visible: r.k === "themes"; columns: 3; spacing: 6
                                        model: r.k === "themes" ? core.themeChoices(r).map((o) => ({ o: o, r: r })) : []
                                        delegate: Stack {
                                            Rectangle {
                                                radius: 0; horizontalPadding: 10; verticalPadding: 7
                                                color: core.val(modelData.r) === modelData.o[0] ? signal : containerHigh; colorAnimation: 140
                                                Row {
                                                    spacing: 6
                                                    Icon { visible: core.val(modelData.r) === modelData.o[0]; name: "checkmark"; font.size: 10; color: onSignal }
                                                    Text { text: modelData.o[1]; font.family: fontUi; font.size: 12; colorAnimation: 140; color: core.val(modelData.r) === modelData.o[0] ? onSignal : ink }
                                                }
                                            }
                                            Button { onClicked: core.setv(modelData.r, modelData.o[0]) }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                Column {
                    grow: 1; spacing: 10
                    visible: !core.query && core.page.special === "shortcuts"
                    Text { text: qsTr("Keys from init.lua; Rex reloads it after each change. Click + key, then press the keys (Esc cancels). A key bound here replaces Rex's built-in shortcut for that key; a dock's own key (its .rui file's key) wins over both."); font.family: fontUi; font.size: 12; color: inkDim; wrap: true }
                    Row {
                        spacing: 8
                        Rectangle {
                            grow: 1; radius: 0; color: containerHigh; horizontalPadding: 10; verticalPadding: 7
                            Row { spacing: 8; Icon { name: "magnifyingglass"; font.size: 12; color: inkDim }; TextField { grow: 1; text: core.keyFilter; placeholder: qsTr("Filter: an action, or a key such as ctrl+d"); font.family: fontUi; font.size: 13; color: ink; onTextChanged: core.keyFilter = text } }
                        }
                        Stack { Rectangle { radius: 0; color: primaryContainer; horizontalPadding: 14; verticalPadding: 7; Text { text: qsTr("Reload config"); font.size: 12; color: onPrimaryContainer } }; Button { onClicked: run("client.config.reload") } }
                    }
                    List {
                        grow: 1; spacing: 6
                        model: core.shortcutRows
                        delegate: Rectangle {
                            radius: 0; color: container; horizontalPadding: 14; verticalPadding: 9
                            property bool recording: false
                            Row {
                                spacing: 10
                                Column {
                                    grow: 1
                                    Text { text: qsTr(modelData.title); font.family: fontUi; font.size: 13; color: ink }
                                    Text { text: modelData.name; font.size: 10; font.mono: true; color: inkDim }
                                }
                                Grid {
                                    columns: Math.max(1, modelData.keys.length); spacing: 6
                                    model: modelData.keys
                                    delegate: Stack {
                                        Rectangle {
                                            radius: 0; color: containerHighest; horizontalPadding: 8; verticalPadding: 4
                                            Row { spacing: 6; valign: "center"; KeyCap { key: modelData; small: true }; Icon { name: "xmark"; font.size: 9; color: caption } }
                                        }
                                        Button { onClicked: rx.send({ unbind: modelData }) }
                                    }
                                }
                                Stack {
                                    Rectangle {
                                        width: 130; radius: 0; color: recording ? primaryContainer : containerHigh; horizontalPadding: 8; verticalPadding: 4
                                        Text { text: recording ? qsTr("Press keys…") : qsTr("+ key"); font.size: 12; font.mono: true; color: recording ? onPrimaryContainer : inkDim }
                                    }
                                    Button {
                                        onClicked: { recording = !recording; recordKey(recording); }
                                        onKeyRecorded: { recording = false; if (key) rx.send({ bind: { key: key, action: modelData.name } }); }
                                    }
                                }
                            }
                        }
                    }
                }

                Column {
                    grow: 1; spacing: 10
                    visible: !core.query && core.page.special === "config"
                    Row {
                        spacing: 6
                        Stack { Rectangle { radius: 0; horizontalPadding: 12; verticalPadding: 6; color: core.file === 0 ? primary : containerHigh; Text { text: "init.lua"; font.size: 12; font.mono: true; color: core.file === 0 ? onPrimary : ink } }; Button { onClicked: core.file = 0 } }
                        Stack { Rectangle { radius: 0; horizontalPadding: 12; verticalPadding: 6; color: core.file === 1 ? primary : containerHigh; Text { text: "rui-config.lua"; font.size: 12; font.mono: true; color: core.file === 1 ? onPrimary : ink } }; Button { onClicked: core.file = 1 } }
                        Item { grow: 1 }
                        Text { text: core.file === 0 ? ((rx.state.paths || {}).init || "") : ((rx.state.paths || {}).conf || ""); font.size: 11; font.mono: true; color: caption }
                    }
                    Rectangle {
                        grow: 1; radius: 0; color: container; padding: 6
                        TabPreview {
                            height: 560; radius: 0
                            session: "rexui-config"; cwd: "~/.config/rex"
                            command: core.nvimListen
                        }
                    }
                    Row {
                        spacing: 8
                        Text { text: qsTr("nvim: :w saves (init.lua: Rex reloads it; rui-config.lua: applied within 3 s). Esc is nvim's here; close with ✕ or a click outside."); font.size: 11; color: inkDim; wrap: true; grow: 1 }
                    }
                }

                Column {
                    grow: 1; spacing: 10
                    visible: !core.query && core.page.special === "commands"
                    Rectangle {
                        radius: 0; color: containerHigh; horizontalPadding: 10; verticalPadding: 7
                        Row { spacing: 8; Icon { name: "line.3.horizontal.decrease"; font.size: 12; color: inkDim }; TextField { grow: 1; text: core.filter; placeholder: qsTr("Filter commands"); font.family: fontUi; font.size: 13; color: ink; onTextChanged: core.filter = text } }
                    }
                    List {
                        grow: 1; spacing: 4
                        model: core.commands
                        delegate: Stack {
                            Rectangle {
                                radius: 0; color: container; horizontalPadding: 14; verticalPadding: 8
                                Row {
                                    spacing: 10
                                    Text { text: qsTr(modelData.title); font.family: fontUi; font.size: 13; color: ink }
                                    Text { text: modelData.name; font.size: 11; font.mono: true; color: caption }
                                    Item { grow: 1 }
                                    Text { visible: (modelData.args || []).length > 0; text: (modelData.args || []).join(", "); font.size: 11; color: inkDim }
                                    Icon { visible: !(modelData.args || []).some((a) => !a.endsWith("?")); name: "play.fill"; font.size: 10; color: primary }
                                }
                            }
                            Button { onClicked: { if (!(modelData.args || []).some((a) => !a.endsWith("?"))) { panel.open = false; run(modelData.name); } } }
                        }
                    }
                }
            }
        }
    }
}
