Dock {
    side: "right"; width: 620
    padding: 10; spacing: 8
    color: surface
    group: "side"; title: web.title || qsTr("Docs"); iconColor: "#6a9bcc"
    icon: "book.pages.fill"

    property string scheme: conf.values["clay-scheme"] || "auto"
    property bool light: scheme === "ivory" || (scheme === "auto" && !theme.dark)
    property var pal: (light ? "faf9f5 f0eee6 e8e6dc dedcd1 c6613f ffffff 141413 5e5d59 87867f"
                             : "1f1e1d 262624 30302e 3a3936 d97757 ffffff f5f4ef c2c0b6 8e8c85").split(" ").map((c) => "#" + c)
    property var surface: pal[0]
    property var container: pal[1]
    property var primary: pal[4]
    property var ink: pal[6]
    property var inkDim: pal[7]
    property var outline: pal[8]
    property var hairline: light ? "#1f141413" : "#1cfaf9f5"

    Row {
        spacing: 8; horizontalPadding: 6; verticalPadding: 2
        Column {
            grow: 1; spacing: 1
            Text { text: web.title || qsTr("Docs"); font.family: "serif"; font.size: 16; color: ink; colorAnimation: 160 }
            Text { text: (web.currentUrl || "").replace("https://", ""); font.size: 11; color: outline }
        }
        Button { icon: "chevron.left"; font.size: 12; color: inkDim; enabled: web.canGoBack; opacity: web.canGoBack ? 1 : 0.3; onClicked: web.back() }
        Button { icon: "chevron.right"; font.size: 12; color: inkDim; enabled: web.canGoForward; opacity: web.canGoForward ? 1 : 0.3; onClicked: web.forward() }
        Button { icon: web.loading ? "xmark" : "arrow.clockwise"; font.size: 12; color: inkDim; onClicked: web.loading ? web.stop() : web.reload() }
        Button { icon: "house"; font.size: 12; color: inkDim; onClicked: web.load("https://docs.claude.com/en/home") }
    }
    Rectangle { height: 2; radius: 1; color: web.loading ? primary : "transparent"; colorAnimation: 300 }

    Rectangle {
        grow: 1; radius: 12; color: container
        border.width: 1; border.color: hairline
        WebView {
            id: web
            url: "https://docs.claude.com/en/home"
            search: "https://docs.claude.com/en/home?q=%s"
            suspend: 600
        }
    }
}
