Dock {
    padding: 0; spacing: 0
    color: bg

    property bool dark: theme.dark
    property var bg: dark ? "#16181c" : "#f6f6f8"
    property var field: dark ? "#ffffff12" : "#0000000d"
    property var ink: dark ? "#e3e5e8" : "#1d1f23"
    property var start: pane.args[0] || "https://duckduckgo.com"
    property bool editing: false

    Row {
        visible: editing
        spacing: 2; padding: 6; valign: "center"
        Button { icon: "chevron.left"; font.size: 12; color: ink; enabled: web.canGoBack; opacity: web.canGoBack ? 0.9 : 0.3; onClicked: web.back() }
        Button { icon: "chevron.right"; font.size: 12; color: ink; enabled: web.canGoForward; opacity: web.canGoForward ? 0.9 : 0.3; onClicked: web.forward() }
        Button {
            icon: web.loading ? "xmark" : "arrow.clockwise"; font.size: 11; color: ink; opacity: 0.9
            onClicked: web.loading ? web.stop() : web.reload()
        }
        Item { width: 4 }
        Rectangle {
            grow: 1; radius: 7; color: field
            horizontalPadding: 10; verticalPadding: 5
            TextField {
                id: address
                placeholder: qsTr("Search or type a URL")
                font.size: 12; color: ink
                onAccepted: {
                    if (["ublock", "ubo", "ubol"].includes(text.trim().toLowerCase())) web.adblockSettings()
                    else if (text.trim()) web.load(text)
                    editing = false; web.forceActiveFocus()
                }
                onCancelled: { editing = false; text = web.currentUrl; web.forceActiveFocus() }
            }
        }
    }

    WebView {
        id: web
        grow: 1
        adblock: true
        search: "https://duckduckgo.com/?q="
        url: start
        onCurrentUrlChanged: if (!editing) address.text = currentUrl
        onFailed: { editing = true; address.text = currentUrl || start }
        onCommand: if (name === "address") { editing = true; address.text = currentUrl; address.forceActiveFocus() }
    }
}
