}

type List : box {
    model: list = fn []  measure js
    modelKey: any = unset  measure js
    follow: bool = false  measure
    maxHeight: real = 0  measure
    reveal: real = -1  measure
    revealAlign: enum(center) = ""  measure
    revealAnimation: real = 0  measure
    fade: real = 0  measure
    gutter: real = 10  measure
    virtualized: bool = false  measure
    rowHeight: real = 0  measure
    overscan: real = -1  measure
    orientation: enum?(vertical|horizontal) = unset  measure
    contentX: real? = unset  paint
    contentY: real? = unset  paint
    focusable: bool = false  measure
    focusRing: bool = true  measure
    focused: bool = false  measure js
    objects: delegate
    signals: window(first, count), scrolled(x, y), keyPressed(key, mods, text), keyReleased(key, mods)
    methods: forceActiveFocus, releaseFocus, scrollTo
}

type Scroll : box {
    orientation: enum?(vertical|horizontal) = unset  measure
    contentX: real? = unset  paint
    contentY: real? = unset  paint
    follow: bool = false  measure
    fade: real = 0  measure
    gutter: real = 10  measure
    signals: scrolled(x, y)
    methods: scrollTo
}

