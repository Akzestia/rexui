type WebView : visual {
    cookies: string = ""  measure
    storage: list = fn []  measure
    adblock: bool = true  measure
    css: string = ""  measure
    url: string = ""  measure
    search: string = ""  measure
    zoom: real = 1  measure
    lazy: bool = true  measure
    suspend: real = 300  measure
