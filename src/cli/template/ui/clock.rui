use "components"

Dock {
    side: "right"; width: 260; padding: 12; spacing: 10
    key: "cmd+shift+2"
    property var now: new Date()
    Timer { interval: 1000; aligned: true; onTriggered: now = new Date() }
    Panel { title: qsTr("Clock"); Text { text: now.toLocaleTimeString(i18n.locale) } }
}
