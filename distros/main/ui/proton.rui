Dock {
    side: "right"; width: 620
    group: "side"; title: "Proton Mail"; iconColor: "#6d4aff"
    icon: web.favicon || "envelope.fill"
    key: "cmd+shift+m"

    Rectangle {
        grow: 1; radius: 10
        WebView {
            id: web
            cookies: "zen"
            storage: ["mail.proton.me", "account.proton.me"]
            url: "https://mail.proton.me"
        }
    }
}
